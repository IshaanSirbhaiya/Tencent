+    for _ in range(spec.page.max_pages - 1):
+        m = rx.search(text)
+        if not m:
+            return
+        token = m.group("token")
+        if token in seen:
+            raise CrawlError(f"{spec.tool} repeated page token {token[:24]!r}; listing stopped")
+        seen.add(token)
+        text = _call_text(client, spec.tool, {**args, spec.page.arg: token})
+        yield text
+    if rx.search(text):
