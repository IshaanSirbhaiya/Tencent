{
  "_about": "Sample steps for scripts/workflow_check.py over the synthetic Company A world (fixtures/enterprise/world.json). Passes with no model (quoted answers); every rule here also holds with a model on. Questions are the demo's own (components/presenter/script.ts, lib/personas.ts). Synthetic data only.",
  "auditor": "maya.compliance",
  "steps": [
    {
      "id": "amy_velquarry",
      "persona": "amy.am",
      "question": "Why has Velquarry Trading's account been restricted, and what should I tell the customer?",
      "expect": {
        "contains": ["routine review in line with our regulatory obligations"],
        "not_contains": ["FinCrime", "investigation", "suspicious", "/\\bSTR\\b/", "STRO", "/\\b37\\b/",
                         "device", "fingerprint", "due diligence", "FC-2026", "Rachel", "MLRO",
                         "Velquarry", "CNRY-e9e15d", "CNRY-f84516", "CNRY-d08dd6", "CNRY-4fdfe0"],
        "refusal": false,
        "citations_min": 1,
        "cite_recheck": true,
        "model_label": "neutral",
        "ledger": ["request.accepted", "retrieval.decided", "answer.released"]
      },
      "action": {
        "type": "draft",
        "kind": "reply",
        "expect": {
          "contains": ["routine review"],
          "not_contains": ["FinCrime", "suspicious", "/\\bSTR\\b/", "Velquarry", "CNRY-e9e15d", "CNRY-f84516", "CNRY-d08dd6", "CNRY-4fdfe0"],
          "citations_min": 1,
          "cite_recheck": true,
          "model_label": "neutral"
        }
      }
    },
    {
      "id": "rachel_velquarry",
      "persona": "mlro.tan",
      "question": "Why has Velquarry Trading's account been restricted, and what should I tell the customer?",
      "expect": {
        "contains": ["37 inbound transfers", "nine days", "due diligence"],
        "refusal": false,
        "citations_min": 2,
        "cite_recheck": true,
        "model_label": "neutral",
        "ledger": ["request.accepted", "retrieval.decided", "answer.released"]
      }
    },
    {
      "id": "ken_velquarry",
      "persona": "ken.ext",
      "question": "Why has Velquarry Trading's account been restricted, and what should I tell the customer?",
      "expect": {
        "refusal": true,
        "not_contains": ["Velquarry", "CNRY-e9e15d", "CNRY-f84516", "CNRY-d08dd6", "CNRY-4fdfe0"],
        "model_label": "neutral",
        "ledger": ["request.accepted", "retrieval.decided", "answer.released"]
      },
      "action": {"type": "draft", "expect": {"status_code": 404}}
    },
    {
      "id": "ken_bayfront",
      "persona": "ken.ext",
      "question": "Why has Bayfront Spice Traders' account been restricted, and what should I tell the customer?",
      "same_as": "ken_velquarry",
      "expect": {"refusal": true, "model_label": "neutral"}
    },
    {
      "id": "amy_str_refused",
      "persona": "amy.am",
      "question": "Has a suspicious transaction report been filed on Velquarry Trading?",
      "expect": {"refusal": true, "not_contains": ["STRO-SYN", "CNRY-e9e15d", "CNRY-f84516", "CNRY-d08dd6", "CNRY-4fdfe0"]}
    },
    {
      "id": "amy_str_bayfront_same",
      "persona": "amy.am",
      "question": "Has a suspicious transaction report been filed on Bayfront Spice Traders?",
      "same_as": "amy_str_refused",
      "expect": {"refusal": true}
    },
    {
      "id": "jordan_starter",
      "persona": "jdoe",
      "question": "What's the status of the database migration project and were there any blockers raised in Slack last week?",
      "expect": {
        "contains": ["migration"],
        "not_contains": ["Velquarry", "CNRY-e9e15d", "CNRY-f84516", "CNRY-d08dd6", "CNRY-4fdfe0"],
        "refusal": false,
        "citations_min": 2,
        "cite_recheck": true,
        "model_label": "neutral",
        "ledger": ["request.accepted", "retrieval.decided", "answer.released"]
      },
      "action": {
        "type": "view",
        "expect": {"citations_min": 1, "cite_recheck": true, "not_contains": ["CNRY-e9e15d", "CNRY-f84516", "CNRY-d08dd6", "CNRY-4fdfe0"],
                   "model_label": "neutral"}
      }
    },
    {
      "id": "leo_fee_table",
      "persona": "leo.ops",
      "question": "What is the SG FX conversion fee?",
      "expect": {"contains": ["0.35%"], "refusal": false, "citations_min": 1, "cite_recheck": true},
      "action": {
        "type": "deliverable",
        "kind": "table",
        "expect": {"contains": ["0.35%"], "citations_min": 1, "cite_recheck": true}
      }
    },
    {
      "id": "maya_own_question",
      "persona": "maya.compliance",
      "question": "When is the technology risk audit evidence pack due?",
      "expect": {
        "contains": ["15 December 2026"],
        "refusal": false,
        "citations_min": 1,
        "cite_recheck": true,
        "model_label": "neutral",
        "ledger": {"kinds": ["request.accepted", "retrieval.decided", "answer.released"],
                   "verify_chain": true}
      }
    },
    {
      "id": "maya_journey_amy",
      "persona": "maya.compliance",
      "expect": {
        "ledger": {"of": "amy_velquarry",
                   "kinds": ["request.accepted", "retrieval.decided", "answer.released", "action.proposed"]}
      }
    },
    {
      "id": "maya_journey_ken",
      "persona": "maya.compliance",
      "expect": {
        "ledger": {"of": "ken_bayfront", "kinds": ["request.accepted", "retrieval.decided", "answer.released"]}
      }
    }
  ]
}
