# DataBridge — LLM backend configuration.
# Copy this to `.env` and fill in ONE key. The gateway auto-detects which backend to use.
# (.env is git-ignored — never commit real keys.)

# Option A: OpenAI (recommended for the demo)
# OPENAI_API_KEY=sk-...

# Option B: Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Option C: Local Ollama (no key needed; start `ollama serve` first)
# OLLAMA_BASE_URL=http://localhost:11434

# With NO key set, the gateway falls back to the deterministic FakeBackend (airgapped CI/demo)
# and every grounded answer still works — it just isn't LLM-narrated (is_real_llm=false).
