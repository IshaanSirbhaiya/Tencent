# packs/finance/evals/agent_contract.jsonl — the ANSWER-CONTRACT golden set every agent compiled
# from plain English in the finance pack binds to, unless a per-agent set is bound instead.
#
# SYNTHETIC FIXTURE over the Walnut finance estate (fixtures/packs/finance). Every party, facility
# and figure is invented. Values were READ from the estate's seed SQL by a generator, not typed.
#
# It measures the behaviour EVERY agent owes regardless of its job, not domain accuracy:
#   * a stated value cites the cell it came from (an amount with its currency);
#   * a value stored in several spellings is counted over all of them;
#   * an absent value is abstained on, never guessed or defaulted;
#   * identity is never resolved by an agent: candidates go to a human;
#   * a source that is not connected is reported as reduced coverage, never silently skipped.
#
# Record fields and the cite format are the workspace pack's (packs/workspace/evals/
# agent_contract.jsonl): `<connection>.<schema>.<table>/<row key>#<column>`; `cite` is ONE cell,
# `cites` every cell a computed value read. `why` is required for an abstention; `outcome` says
# what the agent must REPORT.
#
# Minimal on purpose: seven cases. Add per-agent sets for domain accuracy.
{"id": "fa-001", "ask": "what is the limit amount of facility CB-F-000302?", "expect": {"limit_amount": {"value": "33600000.00", "cite": "finance_core_banking.core_banking.facility/CB-F-000302#limit_amount"}, "currency": {"value": "HKD", "cite": "finance_core_banking.core_banking.facility/CB-F-000302#currency"}}, "expect_abstain": false, "why": "an amount is stated with its currency, each cited to its own cell; 33,600,000.00 and 33600000 are one value"}
{"id": "fa-002", "ask": "how much of facility CB-F-000302 is drawn?", "expect": {"drawn_amount": {"value": "9887654.15", "cite": "finance_core_banking.core_banking.facility/CB-F-000302#drawn_amount"}}, "expect_abstain": false}
{"id": "fa-003", "ask": "which party borrows under facility CB-F-000302?", "expect": {"party_id": {"value": "CB-P-000001", "cite": "finance_core_banking.core_banking.facility/CB-F-000302#party_id"}}, "expect_abstain": false, "why": "the facility row names its party by id; the party's identity is not resolved by naming it"}
{"id": "fa-004", "ask": "how many facilities are on the watchlist?", "expect": {"watchlist_facilities": {"value": "33", "cites": ["finance_core_banking.core_banking.facility/CB-F-000014#status", "finance_core_banking.core_banking.facility/CB-F-000024#status", "finance_core_banking.core_banking.facility/CB-F-000025#status", "finance_core_banking.core_banking.facility/CB-F-000039#status", "finance_core_banking.core_banking.facility/CB-F-000040#status", "finance_core_banking.core_banking.facility/CB-F-000057#status", "finance_core_banking.core_banking.facility/CB-F-000064#status", "finance_core_banking.core_banking.facility/CB-F-000085#status", "finance_core_banking.core_banking.facility/CB-F-000087#status", "finance_core_banking.core_banking.facility/CB-F-000093#status", "finance_core_banking.core_banking.facility/CB-F-000100#status", "finance_core_banking.core_banking.facility/CB-F-000116#status", "finance_core_banking.core_banking.facility/CB-F-000130#status", "finance_core_banking.core_banking.facility/CB-F-000131#status", "finance_core_banking.core_banking.facility/CB-F-000136#status", "finance_core_banking.core_banking.facility/CB-F-000151#status", "finance_core_banking.core_banking.facility/CB-F-000165#status", "finance_core_banking.core_banking.facility/CB-F-000170#status", "finance_core_banking.core_banking.facility/CB-F-000171#status", "finance_core_banking.core_banking.facility/CB-F-000172#status", "finance_core_banking.core_banking.facility/CB-F-000190#status", "finance_core_banking.core_banking.facility/CB-F-000194#status", "finance_core_banking.core_banking.facility/CB-F-000196#status", "finance_core_banking.core_banking.facility/CB-F-000248#status", "finance_core_banking.core_banking.facility/CB-F-000255#status", "finance_core_banking.core_banking.facility/CB-F-000265#status", "finance_core_banking.core_banking.facility/CB-F-000271#status", "finance_core_banking.core_banking.facility/CB-F-000281#status", "finance_core_banking.core_banking.facility/CB-F-000287#status", "finance_core_banking.core_banking.facility/CB-F-000303#status", "finance_core_banking.core_banking.facility/CB-F-000311#status", "finance_core_banking.core_banking.facility/CB-F-000314#status", "finance_core_banking.core_banking.facility/CB-F-000320#status"]}}, "expect_abstain": false, "why": "status stores one value in 3 spellings (WATCHLIST, Watchlist, watchlist); a count over one spelling is incomplete, and the count is measured with SQL over the facts, not estimated"}
{"id": "fa-005", "ask": "what is the interest-rate floor on facility CB-F-000302?", "expect": {}, "expect_abstain": true, "why": "no source in the estate records an interest-rate floor; the value is absent, not zero", "outcome": {"reason_code": "value_absent", "human_confirmation_required": false, "coverage_status": "complete"}}
{"id": "fa-006", "ask": "is the Fairmont Reach Property LLC in the CRM the same party as CB-P-000001 in core banking?", "expect": {}, "expect_abstain": true, "why": "identity is never resolved by an agent; the core-banking party is presented as a candidate for a human to confirm", "outcome": {"reason_code": "identity_candidate", "human_confirmation_required": true, "coverage_status": "complete", "candidates": [{"subject_kind": "party", "value": "Fairmont Reach Property LLC", "cites": ["finance_core_banking.core_banking.party/CB-P-000001#legal_name", "finance_core_banking.core_banking.party/CB-P-000001#registration_no"]}]}}
{"id": "fa-007", "ask": "what does the market data feed say about Fairmont Reach Property LLC's rating?", "expect": {}, "expect_abstain": true, "why": "market data is not a connected source in this deployment; report it as not connected (reduced coverage), never answer from other sources as if it were", "outcome": {"reason_code": "source_not_connected", "human_confirmation_required": false, "coverage_status": "reduced", "not_connected": ["market_data"]}}
