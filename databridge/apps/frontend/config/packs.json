        "intelligence": [
          {
            "label": "Ask",
            "note": "Read straight from the pack graph. Every value arrives with the pointer it came from — and only the last one asks for figures, which is why only it makes them appear.",
            "chips": [
              {
                "id": "ask-issuers",
                "label": "which issuers sent documents?",
                "payload": "which issuers sent documents?"
              },
              {
                "id": "ask-blocked",
                "label": "what is blocked right now?",
                "payload": "what is blocked right now?"
              },
