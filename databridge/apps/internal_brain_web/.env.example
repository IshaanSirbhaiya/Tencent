# Server-side only: where the Internal Brain API listens. Never prefix with NEXT_PUBLIC_.
IB_API_URL=http://127.0.0.1:8100
# Set to 1 to serve built-in fixtures for every endpoint (no backend needed).
NEXT_PUBLIC_IB_MOCK=0
# Behind a TLS proxy: the public origin browsers use (the cross-site check compares Origin to it).
# Leave unset for local runs.
# IB_PUBLIC_ORIGIN=https://brain.example.com
