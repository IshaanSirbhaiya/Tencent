# secrets — never commit real API keys (the gateway reads these at startup; .env.example is fine)
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
.uv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local workspace produced by the CLI (a demo is a zippable dir; not committed)
.databridge/

# OS
.DS_Store
Thumbs.db

# scratch test-output files (Bash multi-line stdout workaround)
*.log
/r.txt
/*.out.txt

# Walnut knowledge-graph mode (start-walnut-kg.ps1): graph store, captures, ingest runs and the
# Google Drive OAuth client + sign-in token all live under var/. Also ignored by the repo-root
# .gitignore; repeated here so this directory is safe on its own.
/var/
# Google Drive MCP credentials, wherever someone drops them by mistake
gcp-oauth.keys.json
**/secrets/gdrive/
