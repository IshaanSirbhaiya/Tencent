# Walnut Internal Brain: public demo env file. deploy.sh writes the real one to /opt/walnut/walnut.env
# (mode 600, outside the git checkout) with freshly generated values; this file is only a template.
# Generate each secret with:   openssl rand -hex 32
# NEVER put a real Slack, Atlassian or Google credential or workspace URL in here: the demo is synthetic
# data only and docker-compose.yml pins every platform to the in-stack mock.

# --- Public address ----------------------------------------------------------------------------
# Your domain (an A record pointing at the VM), or <public-ip-with-dashes>.sslip.io (no DNS needed).
DOMAIN=203-0-113-10.sslip.io
# Host ports Caddy publishes. Keep 80/443 on the VM (Let's Encrypt needs both); change only for a local test.
HTTP_PORT=80
HTTPS_PORT=443

# --- Demo sign-in ------------------------------------------------------------------------------
# REQUIRED: the persona picker only works with this passcode. Share it with judges only.
# (IB_DEMO_LOGIN=1 and IB_DEPLOYED=1 are fixed in docker-compose.yml and cannot be turned off here.)
IB_DEMO_PASSCODE=replace-with-openssl-rand-hex-8

# --- Internal Brain keys (>= 32 chars; IB_DEPLOYED=1 refuses the dev defaults) ------------------
# Changing IB_LEDGER_KEY after the first start makes the existing ledger unverifiable: reset the demo too.
IB_TOKEN_KEY=replace-with-openssl-rand-hex-32
IB_LEDGER_KEY=replace-with-openssl-rand-hex-32

# --- Mock platform secrets (shared by the mock and the Brain; never leave the VM) ---------------
# The two tokens must differ.
MOCK_SVC_TOKEN=replace-with-openssl-rand-hex-32
MOCK_ADMIN_TOKEN=replace-with-openssl-rand-hex-32
MOCK_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32

# --- Model (optional) -------------------------------------------------------------------------
# Tencent TokenHub key for Hunyuan hy3 (fallback deepseek-v4.1-flash). Empty = deterministic extractive
# answers only (the demo still works). Only permitted, released passages are ever sent to the model.
TOKENHUB_API_KEY=
TOKENHUB_BASE=https://tokenhub-intl.tencentcloudmaas.com/v1
# 1 = never call a model even if a key is set
IB_FORCE_OFFLINE=0

# --- Freshness and ledger anchoring (optional) ---------------------------------------------------
# Poll fallback for change events (seconds).
IB_POLL_S=120
# How often the ledger head is published to the anchor sink (seconds).
IB_ANCHOR_INTERVAL_S=900
# Path INSIDE the ib container for the external head file. Empty = /var/lib/ib/external_anchor/heads.jsonl,
# which is on the same host (not off-host; see docs/tencent/SECURITY.md section 3).
IB_ANCHOR_FILE=
